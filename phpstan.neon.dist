includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpat/phpat/extension.neon

parameters:
    level: max
    paths:
        - src
        - app
        - app/artisan
        - bin/earning-line
        - tests
    excludePaths:
        # Files that Laravel writes at run time.
        - app/bootstrap/cache
        - app/storage

services:
    # Architecture rules (phpat) run as part of static analysis.
    -
        class: Tests\Architecture\LayerRules
        tags:
            - phpat.test
